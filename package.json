{
  "name": "chatgpt-usage-visualizer",
  "version": "0.6.0",
  "description": "在 Codex 桌面端侧边栏显示 5 小时与每周额度的实时倒计时（非官方）",
  "type": "module",
  "bin": {
    "chatgpt-usage": "bin/chatgpt-usage.js"
  },
  "files": [
    "bin",
    "src",
    "config",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "install.sh",
    "uninstall.sh",
    "install.ps1",
    "uninstall.ps1",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/chatgpt-usage.js start",
    "doctor": "node bin/chatgpt-usage.js doctor",
    "test": "node --test test/core.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "license": "MIT",
  "keywords": [
    "codex",
    "usage",
    "rate-limit",
    "countdown"
